# Copy this file to .env and adjust as needed.

# --- App ---
APP_NAME=DocMind Chat
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Storage paths (inside the container) ---
DATA_DIR=/app/data
USER_DOCS_DIR=/app/data/user_docs
CHROMA_DIR=/app/data/chroma_db
CHROMA_COLLECTION_NAME=docmind_collection

# --- Model backend ---
# "huggingface": raw weights loaded in-process (docker-compose.yml).
# "ollama": quantized GGUF served by a separate container, much lower
#           memory footprint (docker-compose.ollama.yml sets this for you —
#           you don't need to change it by hand for that variant).
MODEL_BACKEND=huggingface

# --- HuggingFace backend: embedding + LLM (downloaded on first run & cached) ---
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
LLM_CONTEXT_WINDOW=8192
LLM_MAX_NEW_TOKENS=256
# "auto" uses GPU if available (via accelerate), "cpu" forces CPU
LLM_DEVICE_MAP=auto

# --- Ollama backend (only used when MODEL_BACKEND=ollama) ---
# Service name + port from docker-compose.ollama.yml; change only if you
# point this at an Ollama instance running somewhere else.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=mistral:7b-instruct-v0.2-q4_0
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_S=180
OLLAMA_PULL_TIMEOUT_S=1800

# --- Retrieval defaults ---
SIMILARITY_TOP_K=4
RESPONSE_MODE=compact

# --- HuggingFace cache location (persisted via volume so models aren't
#     re-downloaded on every container restart). Not used by the Ollama
#     backend — Ollama keeps its own model store. ---
HF_HOME=/app/data/hf_cache

# --- Required only if you select a gated HuggingFace-backend model from
#     the gallery (e.g. Llama 3.2 1B/3B Instruct). Get a token at
#     https://huggingface.co/settings/tokens and accept that model's
#     license on its HuggingFace page first. Not needed for the Ollama
#     backend's Llama tags — those aren't gated via Ollama. ---
HF_TOKEN=
